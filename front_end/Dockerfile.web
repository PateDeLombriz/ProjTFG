FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PUB_CACHE=/home/developer/.pub-cache
ENV PATH="/home/developer/flutter/bin:${PATH}"

# Dependencias mínimas para Flutter Web
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    unzip \
    xz-utils \
    zip \
    libglu1-mesa \
    && rm -rf /var/lib/apt/lists/*

# Crear usuario de desarrollo
RUN useradd -u 1000 -ms /bin/bash developer

# Instalar Flutter
USER developer
WORKDIR /home/developer
RUN git clone https://github.com/flutter/flutter.git --branch stable --depth 1

# Preparar Flutter Web y caché
RUN flutter config --enable-web && flutter precache --web

# Preparar directorios de trabajo y caché
RUN mkdir -p /home/developer/.pub-cache /home/developer/app

# Volver al usuario de trabajo
WORKDIR /home/developer/app